# --- backend ---
PORT=8402
HOST=0.0.0.0
# Postgres connection string. Leave empty to use embedded PGlite (dev/test only).
DATABASE_URL=postgres://actp:actp@localhost:5432/actp

# --- chain / indexer ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=8453
VENDOR_REGISTRY_ADDRESS=
ATTESTATION_REGISTRY_ADDRESS=
DEPLOY_BLOCK=0
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_MS=2000
INDEXER_REORG_DEPTH=64

# --- API auth (mutating endpoints) ---
ADMIN_API_KEY=

# --- content-addressed document storage (IPFS) ---
# 'memory' (default, in-process — dev/test) or 'kubo' (self-hosted IPFS node)
IPFS_MODE=memory
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=http://127.0.0.1:8080

# --- V4 contract intelligence ---
# 'deterministic' (default, no network) or 'llm'
CONTRACT_EXTRACTOR=deterministic
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=claude-opus-4-8

LOG_LEVEL=info

# --- deployment (forge) ---
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ADMIN_ADDRESS=
VERIFIER_ADDRESS=
