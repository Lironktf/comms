{
  "name": "@actp/zk",
  "version": "0.1.0",
  "private": true,
  "description": "Grayr private agent payments: shielded-pool client (notes, keys, tree sync, proving), relayer, and the x402 `shielded` scheme",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./x402": "./dist/x402/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.e2e.test.ts'",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "tsx scripts/bench.ts",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@aztec/bb.js": "5.2.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noir-lang/noir_js": "1.0.0-beta.25",
    "@x402/core": "2.19.0",
    "@x402/evm": "2.19.0",
    "@x402/express": "2.19.0",
    "@x402/fetch": "2.19.0",
    "express": "^4.21.2",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
